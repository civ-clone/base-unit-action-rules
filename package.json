{
  "name": "@civ-clone/base-unit-action-rules",
  "version": "0.1.1",
  "description": "Building blocks for a ruleset's unit action rules: route planning for go-to and the actions that build along a route.",
  "repository": "git@github.com:civ-clone/base-unit-action-rules.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-engine": "^0.1.0",
    "@civ-clone/core-registry": "^0.1.0",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-strategy": "^0.1.0",
    "@civ-clone/core-unit": "^0.1.31",
    "@civ-clone/core-world": "^0.1.0",
    "@civ-clone/core-world-path": "^0.1.3"
  }
